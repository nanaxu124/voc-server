# Required: VOC MCP Streamable-HTTP endpoint.
VOC_MCP_URL=https://your-mcp-host.example/mcp

# Optional: server-side MCP credential. Never put this value in HTML/JS.
VOC_MCP_AUTH_TOKEN=

# Optional: internal CA bundle when the MCP/LLM endpoint uses a private CA.
# Keep TLS verification enabled; point this to a trusted PEM bundle.
VOC_CA_BUNDLE=

# Required only for the AI chat drawer.
VOC_LLM_BASE_URL=https://your-llm-host.example/llm

# Server settings
PORT=8011
VOC_CORS_ORIGIN=

# Disabled by default. Enables query_voc through the generic proxy only when explicitly needed.
VOC_ALLOW_RAW_QUERY=0
